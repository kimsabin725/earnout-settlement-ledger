-- GENERATED by replay/compile.mjs from replay/clauses/synthetic-suppressed-period.json. Do not edit by hand.
-- Synthetic — a missed period that a one-off outflow would have carried, resolved by the named arbiter
-- Provenance: SYNTHETIC. The fact pattern is the recurring one in Delaware earnout litigation (buyer-controlled cost allocation in a measurement period); every figure is invented to exercise the harness. No practitioner clause is reproduced here.
module Replay.SyntheticSuppressedPeriod where

import Daml.Script
import Earnout

replay : Script ()
replay = script do
  buyer   <- allocatePartyByHint (PartyIdHint "SyntheticSuppressedPeriodBuyer")
  seller  <- allocatePartyByHint (PartyIdHint "SyntheticSuppressedPeriodSeller")
  arbiter <- allocatePartyByHint (PartyIdHint "SyntheticSuppressedPeriodArbiter")
  bank    <- allocatePartyByHint (PartyIdHint "SyntheticSuppressedPeriodBank")

  let terms = EarnoutTerms with
        dealId = "REPLAY-SYN-1"
        metricName = "Quarterly operating net cash flow"
        quarterlyTarget = 80000000.0
        totalQuarters = 4
        requiredMet = 3
        trancheAmount = 400000000.0

  prop <- submit buyer do
    createCmd EarnoutProposal with buyer; seller; arbiter; attestor = bank; terms
  agr0 <- submit seller do exerciseCmd prop Accept

  -- period 1: reported 92000000.0 → MET
  att1 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-1"; attestor = bank; buyer; quarter = 1
      metricValue = 92000000.0; oneOffOutflows = 0.0
      basisHash = "sha256:syn1-p1"
  (agr1, v1) <- submit buyer do
    exerciseCmd agr0 SubmitQuarter with attestationCid = att1

  -- period 2: reported 85000000.0 → MET
  att2 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-1"; attestor = bank; buyer; quarter = 2
      metricValue = 85000000.0; oneOffOutflows = 0.0
      basisHash = "sha256:syn1-p2"
  (agr2, v2) <- submit buyer do
    exerciseCmd agr1 SubmitQuarter with attestationCid = att2

  -- period 3: reported 51000000.0, one-off outflows 30000000.0 → MISSED (flagged)
  att3 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-1"; attestor = bank; buyer; quarter = 3
      metricValue = 51000000.0; oneOffOutflows = 30000000.0
      basisHash = "sha256:syn1-p3"
  (agr3, v3) <- submit buyer do
    exerciseCmd agr2 SubmitQuarter with attestationCid = att3
  -- the clause's own dispute: The 30M outflow was a group restructuring charge allocated into the target entity after closing; excluded for the purpose of the period test.
  d3 <- submit seller do exerciseCmd v3 RaiseDispute
  v3r <- submit arbiter do
    exerciseCmd d3 Resolve with verdictCid = v3; resolvedMet = True; reasoning = "The 30M outflow was a group restructuring charge allocated into the target entity after closing; excluded for the purpose of the period test."

  -- period 4: reported 79000000.0 → MISSED
  att4 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-1"; attestor = bank; buyer; quarter = 4
      metricValue = 79000000.0; oneOffOutflows = 0.0
      basisHash = "sha256:syn1-p4"
  (agr4, v4) <- submit buyer do
    exerciseCmd agr3 SubmitQuarter with attestationCid = att4

  -- 3 of 4 periods met (arbiter resolutions applied); 3 required
  outcome <- submit seller do
    exerciseCmd agr4 Finalize with verdictCids = [v1, v2, v3r, v4]

  -- the parties settled on 400000000.0; the ledger must reach the same figure
  case outcome of
    Left _ -> abort "replay diverged: ledger closed the earnout unpaid, the parties settled a payout"
    Right obligation -> do
      tok <- submit buyer do
        createCmd CashToken with issuer = buyer; owner = buyer; amount = 400000000.0
      (paid, _) <- submit buyer do exerciseCmd obligation Settle with tokenCid = tok
      Some settled <- queryContractId seller paid
      assertMsg "replay diverged: the tranche did not reach the seller" (settled.owner == seller)
      assertMsg "replay diverged: settled amount /= the amount the parties settled on"
        (settled.amount == 400000000.0)
