-- GENERATED by replay/compile.mjs from replay/clauses/synthetic-missed-earnout.json. Do not edit by hand.
-- Synthetic — the earnout genuinely missed, and the ledger must close it unpaid
-- Provenance: SYNTHETIC. Invented figures. Included because a harness that can only reproduce payouts is not a test.
module Replay.SyntheticMissedEarnout where

import Daml.Script
import Earnout

replay : Script ()
replay = script do
  buyer   <- allocatePartyByHint (PartyIdHint "SyntheticMissedEarnoutBuyer")
  seller  <- allocatePartyByHint (PartyIdHint "SyntheticMissedEarnoutSeller")
  arbiter <- allocatePartyByHint (PartyIdHint "SyntheticMissedEarnoutArbiter")
  bank    <- allocatePartyByHint (PartyIdHint "SyntheticMissedEarnoutBank")

  let terms = EarnoutTerms with
        dealId = "REPLAY-SYN-2"
        metricName = "Quarterly operating net cash flow"
        quarterlyTarget = 80000000.0
        totalQuarters = 4
        requiredMet = 3
        trancheAmount = 400000000.0

  prop <- submit buyer do
    createCmd EarnoutProposal with buyer; seller; arbiter; attestor = bank; terms
  agr0 <- submit seller do exerciseCmd prop Accept

  -- period 1: reported 84000000.0 → MET
  att1 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-2"; attestor = bank; buyer; quarter = 1
      metricValue = 84000000.0; oneOffOutflows = 0.0
      basisHash = "sha256:syn2-p1"
  (agr1, v1) <- submit buyer do
    exerciseCmd agr0 SubmitQuarter with attestationCid = att1

  -- period 2: reported 62000000.0, one-off outflows 4000000.0 → MISSED
  att2 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-2"; attestor = bank; buyer; quarter = 2
      metricValue = 62000000.0; oneOffOutflows = 4000000.0
      basisHash = "sha256:syn2-p2"
  (agr2, v2) <- submit buyer do
    exerciseCmd agr1 SubmitQuarter with attestationCid = att2

  -- period 3: reported 58000000.0, one-off outflows 1000000.0 → MISSED
  att3 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-2"; attestor = bank; buyer; quarter = 3
      metricValue = 58000000.0; oneOffOutflows = 1000000.0
      basisHash = "sha256:syn2-p3"
  (agr3, v3) <- submit buyer do
    exerciseCmd agr2 SubmitQuarter with attestationCid = att3

  -- period 4: reported 90000000.0 → MET
  att4 <- submit bank do
    createCmd MetricAttestation with
      dealId = "REPLAY-SYN-2"; attestor = bank; buyer; quarter = 4
      metricValue = 90000000.0; oneOffOutflows = 0.0
      basisHash = "sha256:syn2-p4"
  (agr4, v4) <- submit buyer do
    exerciseCmd agr3 SubmitQuarter with attestationCid = att4

  -- 2 of 4 periods met (arbiter resolutions applied); 3 required
  outcome <- submit seller do
    exerciseCmd agr4 Finalize with verdictCids = [v1, v2, v3, v4]

  -- the parties settled on nothing; the ledger must close the earnout unpaid
  case outcome of
    Right _ -> abort "replay diverged: ledger created a settlement obligation, the parties paid nothing"
    Left closed -> do
      Some c <- queryContractId seller closed
      assertMsg "replay diverged: earnout closed for the wrong reason" (c.dealId == "REPLAY-SYN-2")
